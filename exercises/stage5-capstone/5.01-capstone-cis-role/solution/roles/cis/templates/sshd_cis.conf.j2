{{ ansible_managed | comment }}
# CIS 5.1 - SSH server hardening. Read before any other drop-in (first match wins).

LogLevel {{ cis_sshd_log_level }}
PermitRootLogin {{ cis_sshd_permit_root_login }}
PermitEmptyPasswords no
PermitUserEnvironment no
HostbasedAuthentication no
IgnoreRhosts yes
DisableForwarding yes
X11Forwarding no

MaxAuthTries {{ cis_sshd_max_auth_tries }}
MaxSessions {{ cis_sshd_max_sessions }}
MaxStartups {{ cis_sshd_max_startups }}
LoginGraceTime {{ cis_sshd_login_grace_time }}
ClientAliveInterval {{ cis_sshd_client_alive_interval }}
ClientAliveCountMax {{ cis_sshd_client_alive_count_max }}

Banner {{ cis_sshd_banner }}
AllowGroups {{ cis_sshd_allow_groups | join(' ') }}

Ciphers {{ cis_sshd_ciphers | join(',') }}
MACs {{ cis_sshd_macs | join(',') }}
KexAlgorithms {{ cis_sshd_kex_algorithms | join(',') }}
