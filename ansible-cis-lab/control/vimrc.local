" /etc/vim/vimrc.local - lab defaults (loaded by Debian's /etc/vim/vimrc)
set nocompatible
syntax on
filetype plugin indent on
set background=dark
set number ruler showcmd showmatch
set incsearch hlsearch ignorecase smartcase
set expandtab tabstop=2 shiftwidth=2 softtabstop=2 autoindent
set backspace=indent,eol,start
set encoding=utf-8 fileencoding=utf-8
set listchars=tab:»·,trail:·,nbsp:␣ list
set laststatus=2 wildmenu
" YAML / Ansible: 2 spaces, visible indentation column
autocmd FileType yaml setlocal ts=2 sts=2 sw=2 expandtab cursorcolumn
autocmd BufRead,BufNewFile *.yml.j2,*.yaml.j2 set filetype=yaml
autocmd BufRead,BufNewFile *.j2 if &filetype == '' | set filetype=jinja | endif
" Remember the last cursor position
autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
