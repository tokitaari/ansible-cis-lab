#!/bin/sh
# Installs the control node's public key for the "ansible" account.
# Runs at every container start (systemd unit / OpenRC local.d).
set -eu
KEY=/lab-keys/id_ed25519.pub
i=0
while [ ! -s "$KEY" ] && [ "$i" -lt 120 ]; do
  sleep 1
  i=$((i + 1))
done
[ -s "$KEY" ] || { echo "lab-keysync: $KEY not found" >&2; exit 1; }

install -d -m 0700 -o ansible -g ansible /home/ansible/.ssh
install -m 0600 -o ansible -g ansible "$KEY" /home/ansible/.ssh/authorized_keys
