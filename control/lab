#!/usr/bin/env bash
# lab - exercise helper for the Ansible CIS lab (runs inside the control node)
set -uo pipefail

LAB_ROOT="${LAB_ROOT:-/lab}"
EX_DIR="$LAB_ROOT/exercises"
WORK_DIR="$LAB_ROOT/work"
STATE_DIR="$LAB_ROOT/.lab"
mkdir -p "$STATE_DIR" "$WORK_DIR" 2>/dev/null || true

c_red=$'\e[31m'; c_grn=$'\e[32m'; c_yel=$'\e[33m'; c_bld=$'\e[1m'; c_off=$'\e[0m'
[[ -t 1 ]] || { c_red=; c_grn=; c_yel=; c_bld=; c_off=; }

die()  { echo "${c_red}error:${c_off} $*" >&2; exit 1; }
info() { echo "${c_bld}==>${c_off} $*"; }

usage() {
  cat <<'EOF'
lab - Ansible CIS lab helper

  lab list                  list all exercises (with your progress)
  lab show <id>             show the exercise description
  lab start <id>            create /lab/work/<id>/ (with a starter file where provided)
  lab hint <id> <1|2|3>     show one hint (1 = gentle ... 3 = almost the answer)
  lab check <id> [args]     verify the target state (+ idempotency of your playbook)
                            extra args go to ansible-playbook, e.g. -l debian
  lab explain <id>          show the explanation (read it AFTER solving)
  lab solution <id>         list/print the reference solution files
  lab solve <id> [-y]       apply the reference solution (to catch up)
  lab lang [en|de]          show or set the language for texts
  lab status                connectivity of all targets
  lab progress              exercises you have passed
  lab placement [answers]   placement test to find your starting point (then the key)

Reset a target to its original (non-compliant) state from the HOST:
  ./lab.sh reset <host|all>      (Windows: .\lab.ps1 reset <host|all>)
EOF
}

lang() {
  if [[ -n "${LAB_LANG:-}" ]]; then echo "$LAB_LANG"
  elif [[ -s "$STATE_DIR/lang" ]]; then cat "$STATE_DIR/lang"
  else echo en; fi
}

# localized <dir> <BASENAME>  ->  BASENAME.<lang>.md if present, else BASENAME.md
localized() {
  local l; l="$(lang)"
  if [[ "$l" != en && -f "$1/$2.$l.md" ]]; then echo "$1/$2.$l.md"; else echo "$1/$2.md"; fi
}

# resolve <id>  ->  sets global EXD to the exercise directory (exits on error)
resolve() {
  local id="${1:-}" d
  [[ -n "$id" ]] || die "exercise id missing (try: lab list)"
  for d in "$EX_DIR"/stage*/"$id"-*; do
    [[ -d "$d" ]] && { EXD="$d"; return 0; }
  done
  die "unknown exercise '$id' (try: lab list)"
}

meta() { # meta <dir> <key> [default]
  python3 - "$1/meta.yml" "$2" "${3:-}" <<'PY'
import sys, yaml
m = yaml.safe_load(open(sys.argv[1])) or {}
v = m.get(sys.argv[2], sys.argv[3])
if isinstance(v, bool):
    v = "true" if v else "false"
print("" if v is None else v)
PY
}

# Render markdown/code nicely (lab-view uses rich; falls back to plain text)
view() {
  if command -v lab-view >/dev/null; then lab-view "$@"
  elif [[ -t 1 ]] && command -v less >/dev/null; then less -FRX "${@: -1}"
  else cat "${@: -1}"; fi
}

learner_playbook() { # prints the learner's playbook for <id>, if any
  local id="$1" f
  for f in site.yml playbook.yml; do
    [[ -f "$WORK_DIR/$id/$f" ]] && { echo "$WORK_DIR/$id/$f"; return 0; }
  done
  return 1
}

cmd_list() {
  python3 - "$EX_DIR" "$STATE_DIR/progress" "$(lang)" <<'PY'
import sys, glob, os, yaml
ex_dir, progress, lang = sys.argv[1:4]
done = set()
if os.path.exists(progress):
    done = {l.split()[0] for l in open(progress) if l.strip()}
stage = None
import signal
signal.signal(signal.SIGPIPE, signal.SIG_DFL)
for meta in sorted(glob.glob(os.path.join(ex_dir, "stage*", "*", "meta.yml"))):
    m = yaml.safe_load(open(meta))
    name = m.get("stage_name_" + lang) or m["stage_name"]
    if name != stage:
        stage = name
        print(f"\n\033[1m{stage}\033[0m")
    title = m["title"].get(lang) or m["title"]["en"]
    mark = "\033[32m✔\033[0m" if str(m["id"]) in done else " "
    stars = "★" * m["difficulty"] + "☆" * (5 - m["difficulty"])
    cis = m.get("cis", {}).get("section", "-")
    print(f"  {mark} {m['id']:<5} {stars}  {title:<52} CIS {cis}")
print()
PY
}

cmd_show()    { resolve "${1:-}"; view "$(localized "$EXD" README)"; }
cmd_explain() { resolve "${1:-}"; view "$(localized "$EXD" EXPLANATION)"; }

cmd_hint() {
  local d n f; resolve "${1:-}"; d="$EXD"; n="${2:-1}"
  [[ "$n" =~ ^[1-3]$ ]] || die "hint number must be 1, 2 or 3"
  f="$(localized "$d" HINTS)"
  awk -v n="$n" '/^## /{c++} c==n' "$f" | view -
}

cmd_start() {
  local id="${1:-}" d target
  resolve "$id"; d="$EXD"; target="$WORK_DIR/$id"
  mkdir -p "$target"
  if [[ -d "$d/starter" ]]; then
    cp -rn "$d/starter/." "$target/" 2>/dev/null || true
  fi
  info "Work directory: $target"
  find "$target" -mindepth 1 -maxdepth 1 -printf "    %f\n" 2>/dev/null
  echo
  view "$(localized "$d" README)"
}

recap_problems() { # reads ansible output on stdin, prints non-localhost recap lines with changes/failures
  sed -n '/PLAY RECAP/,$p' | grep -E '^[^ ].*:[[:space:]]+ok=' | grep -Ev '^localhost[[:space:]]' |
    awk '{ bad=0
           for (i=1;i<=NF;i++) { split($i,kv,"=")
             if ((kv[1]=="changed"||kv[1]=="failed"||kv[1]=="unreachable") && kv[2]+0>0) bad=1 }
           if (bad) print }'
}

cmd_check() {
  local id="${1:-}"; shift || true
  local d rc=0 pb out problems
  resolve "$id"; d="$EXD"

  info "State checks for $id"
  if [[ -f "$d/check.sh" ]]; then
    (cd "$d" && LAB_EXERCISE_ID="$id" bash ./check.sh "$@") || rc=1
  elif [[ -f "$d/check.yml" ]]; then
    ansible-playbook "$d/check.yml" "$@" || rc=1
  else
    echo "(no automatic check for this exercise)"
  fi

  if [[ "$(meta "$d" idempotency false)" == true ]]; then
    if pb="$(learner_playbook "$id")"; then
      info "Idempotency: ansible-playbook $pb --check (expect changed=0)"
      out="$(cd "$(dirname "$pb")" && ANSIBLE_NOCOLOR=1 ANSIBLE_FORCE_COLOR=0 \
             ansible-playbook "$(basename "$pb")" --check "$@" 2>&1)"
      problems="$(printf '%s\n' "$out" | recap_problems)"
      if [[ -n "$problems" ]] || ! printf '%s\n' "$out" | grep -q 'PLAY RECAP'; then
        printf '%s\n' "$out" | tail -n 40
        echo "${c_red}Not idempotent (or failed) on:${c_off}"
        printf '%s\n' "${problems:-  playbook did not complete}" | sed 's/^/  /'
        rc=1
      else
        echo "${c_grn}idempotent: second run would change nothing${c_off}"
      fi
    else
      echo "${c_yel}note:${c_off} no playbook found in $WORK_DIR/$id (playbook.yml or site.yml) - idempotency not tested"
    fi
  fi

  echo
  if [[ $rc -eq 0 ]]; then
    echo "${c_grn}${c_bld}PASSED${c_off} $id"
    grep -q "^$id " "$STATE_DIR/progress" 2>/dev/null || echo "$id $(date +%F)" >> "$STATE_DIR/progress"
    echo "Read the explanation now:  lab explain $id"
  else
    echo "${c_red}${c_bld}NOT YET${c_off} $id - read the messages above, then try 'lab hint $id 1'"
  fi
  return $rc
}

cmd_solution() {
  local d f; resolve "${1:-}"; d="$EXD"
  [[ -d "$d/solution" ]] || die "no solution files"
  local files=()
  while IFS= read -r f; do files+=("$f"); done \
    < <(find "$d/solution" -type f ! -name '.vault-pass' ! -name 'vault.yml' | sort)
  view "${files[@]}"
}

cmd_solve() {
  local id="${1:-}" yes="${2:-}" d cmd
  resolve "$id"; d="$EXD"
  cmd="$(meta "$d" solve "ansible-playbook playbook.yml")"
  if [[ "$yes" != "-y" ]]; then
    echo "This applies the reference solution of $id to the targets:"
    echo "    (cd $d/solution && $cmd)"
    read -r -p "Continue? [y/N] " a; [[ "$a" =~ ^[yY] ]] || exit 0
  fi
  (cd "$d/solution" && bash -c "$cmd")
}

cmd_lang() {
  if [[ -z "${1:-}" ]]; then echo "current language: $(lang)"; return; fi
  [[ "$1" =~ ^(en|de)$ ]] || die "supported: en, de"
  echo "$1" > "$STATE_DIR/lang"; echo "language set to $1"
}

cmd_status() {
  # JSON callback instead of the deprecated '-o' / oneline callback (removed in ansible-core 2.23)
  ANSIBLE_LOAD_CALLBACK_PLUGINS=1 ANSIBLE_STDOUT_CALLBACK=ansible.posix.json ANSIBLE_NOCOLOR=1 \
    ansible targets -m ansible.builtin.raw -a 'grep ^PRETTY_NAME= /etc/os-release' 2>/dev/null |
    python3 -c '
import json, sys
txt = sys.stdin.read()
try:
    hosts = json.loads(txt[txt.index("{"):])["plays"][0]["tasks"][0]["hosts"]
except (ValueError, KeyError, IndexError):
    sys.exit("lab status: could not read ansible output - run: ansible targets -m ansible.builtin.ping")
ok = "\033[32mOK\033[0m" if sys.stdout.isatty() else "OK"
bad = "\033[31m{}\033[0m" if sys.stdout.isatty() else "{}"
width = max(map(len, hosts))
for name, r in sorted(hosts.items()):
    if r.get("unreachable"):
        print(f"{name:<{width}}  " + bad.format("UNREACHABLE") + "  " + r.get("msg", "").splitlines()[0][:80])
    elif r.get("failed") or r.get("rc", 0) != 0:
        print(f"{name:<{width}}  " + bad.format("FAILED") + "  " + (r.get("stderr") or r.get("msg", "")).strip()[:80])
    else:
        print(f"{name:<{width}}  {ok}  " + r.get("stdout", "").strip().split("=", 1)[-1].strip(chr(34)))
sys.exit(0 if all(not (r.get("unreachable") or r.get("failed")) for r in hosts.values()) else 1)
'
}

cmd_progress() {
  [[ -s "$STATE_DIR/progress" ]] || { echo "nothing passed yet - start with 'lab placement' or 'lab show 0.01'"; return; }
  sort -V "$STATE_DIR/progress"
}

cmd_placement() {
  if [[ "${1:-}" == answers ]]; then view "$(localized "$EX_DIR" PLACEMENT)"
  else view --strip-details "$(localized "$EX_DIR" PLACEMENT)"
       if [[ "$(lang)" == de ]]; then echo "Lösungsschlüssel und Empfehlung:  lab placement answers"
       else echo "Answer key and recommendation:  lab placement answers"; fi
  fi
}

sub="${1:-help}"; shift || true
case "$sub" in
  list)      cmd_list ;;
  show)      cmd_show "$@" ;;
  start)     cmd_start "$@" ;;
  hint)      cmd_hint "$@" ;;
  check)     cmd_check "$@" ;;
  explain)   cmd_explain "$@" ;;
  solution)  cmd_solution "$@" ;;
  solve)     cmd_solve "$@" ;;
  lang)      cmd_lang "$@" ;;
  status)    cmd_status ;;
  progress)  cmd_progress ;;
  placement) cmd_placement "$@" ;;
  reset)     die "reset needs Docker - run it on the host: ./lab.sh reset <host|all>" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
